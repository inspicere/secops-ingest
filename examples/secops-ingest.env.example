# Example configuration. Values here are read by the worker via the environment.
# Do NOT put credentials in this file: use a secret backend.

# Which secret backend to use: env | file | vault | delinea
SECOPS_SECRETS_BACKEND=file

# For SECOPS_SECRETS_BACKEND=file — one secret per file, named for the secret.
# Works unchanged with systemd LoadCredential=, Docker secrets and Kubernetes
# secrets, which all present secrets as files.
SECOPS_SECRETS_DIR=/etc/secops/secrets

# Database connection. The password belongs in PGPASSFILE, not here.
SECOPS_DB_DSN=host=localhost port=5432 dbname=secops user=secops_ingest
PGPASSFILE=/etc/secops/pgpass

# Pseudonymous join keys are salted. The salt must be at least 32 bytes, must be
# stored as a secret, and must never change once records exist — rotating it
# silently breaks every join to previously written rows.
# SECOPS_PSEUDONYM_SALT is resolved through the secret backend, not set here.
