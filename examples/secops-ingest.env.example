# Example configuration. Values here are read by the worker via the environment.
# Do NOT put credentials in this file: use a secret backend.

# Which secret backend to use: env | file | vault | vault_agent | mapped
# (Delinea is reachable only through a `mapped` document: it needs a credential
# that another provider resolves first.)
SECOPS_SECRETS_BACKEND=file

# For SECOPS_SECRETS_BACKEND=mapped -- the provider that serves the mapping
# document. vault_agent in production; file or env only with a 'dev' map (an
# 'assured' map served from a file or env root is refused).
# SECOPS_SECRETS_MAP_SOURCE=vault_agent
# SECOPS_SECRETS_MAP_NAME=secret-map

# For SECOPS_SECRETS_BACKEND=file — one secret per file, named for the secret.
# Works unchanged with systemd LoadCredential=, Docker secrets and Kubernetes
# secrets, which all present secrets as files.
SECOPS_SECRETS_DIR=/etc/secops/secrets

# Database connection. The password belongs in PGPASSFILE, not here.
SECOPS_DB_DSN=host=localhost port=5432 dbname=secops user=secops_ingest
PGPASSFILE=/etc/secops/pgpass

# Pseudonymous join keys are HMAC-SHA256, keyed by a salt of at least 32
# characters. The salt must be stored as a secret, and must never change once
# records exist — rotating it silently breaks every join to previously written
# rows.
# SECOPS_PSEUDONYM_SALT is resolved through the secret backend, not set here.

# Which installed distributions may register packs. Loading a pack runs its code
# inside this process, which holds every resolved secret, so on a host name the
# distributions you installed on purpose. Comma-separated; core is always
# allowed. Unset loads every installed pack (and logs each one); set but empty
# allows none.
# SECOPS_ALLOWED_PACKS=secops-ingest-knowbe4
