# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Compiled bytecode embeds absolute source paths, so it leaks the build
# directory layout in addition to being churn.

# Environments
.venv/
.venv-*/
venv/

# Local artefacts
*.tgz
*.tar.gz
*.dump
# Anchored to the repo root. Unanchored, `secrets/` matches at ANY depth and
# silently excludes src/secops_ingest/secrets/ and tests/secrets/ — the package
# publishes without the module it is built around, and still imports locally
# because the files are on disk.
/secrets/
*.pem
*.key
